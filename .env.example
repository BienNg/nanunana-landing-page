# ─── Site ────────────────────────────────────────────────────────────────
# Public URL (canonical, sitemap, OG). Leave empty until the domain is moved;
# on Vercel the project URL is used automatically.
NEXT_PUBLIC_SITE_URL=

# Show unverified ({{VERIFY}}) content in a production build (e.g. preview deploys): 1 = show
NEXT_PUBLIC_SHOW_UNVERIFIED=

# ─── Lead destinations (each one is enabled only when its vars are set) ─
# Notion (primary): internal integration token + the leads database id.
# Share the database with the integration ("Connections" → add it).
# Required properties (exact names / types):
#   Name (Title) · Phone (Phone) · Email (Email) · Course (Select) · Goal (Select)
#   Preferred channel (Select) · Message (Text) · UTM Source / UTM Medium /
#   UTM Campaign / UTM Content (Text) · fbclid (Text) · Landing page (URL)
#   Referrer (URL) · Created at (Date) · Status (Select, option "Mới")
NOTION_TOKEN=
NOTION_LEADS_DB_ID=

# Email notification via Resend
RESEND_API_KEY=
# Verified sender, e.g. "NaNu NaNa Website <leads@your-domain.com>" (pending)
RESEND_FROM_EMAIL=
# Recipient(s), comma-separated
LEAD_NOTIFY_EMAIL=

# If no destination is configured, leads are only written to the server log
# ("[lead:unrouted]") — fine for local dev, not for production.

# ─── Spam protection (optional) ─────────────────────────────────────────
# Upstash Redis → rate limit: 5 requests / 10 min per IP
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Cloudflare Turnstile (note: with Turnstile on, the no-JavaScript fallback can't pass the check)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Tracking (optional) ────────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
