# ─── Site ────────────────────────────────────────────────────────────────
# Public URL (canonical, sitemap, OG). Leave empty until the domain is moved;
# on Vercel the project URL is used automatically.
NEXT_PUBLIC_SITE_URL=

# Show unverified ({{VERIFY}}) content in a production build (e.g. preview deploys): 1 = show
NEXT_PUBLIC_SHOW_UNVERIFIED=

# ─── Lead destinations (each one is enabled only when its vars are set) ─
# Notion (primary): integration token + the leads database id
NOTION_TOKEN=
NOTION_LEADS_DB_ID=

# Email notification via Resend
RESEND_API_KEY=
# Verified sender, e.g. "NaNu NaNa Website <leads@your-domain.com>" (pending)
RESEND_FROM_EMAIL=
# Recipient(s), comma-separated
LEAD_NOTIFY_EMAIL=

# ─── Spam protection (optional) ─────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Tracking (optional) ────────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
